&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;setw -g window-status-style &lt;span class=&#34;s1&#34;&gt;&#39;fg=red bg=black&#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;setw -g window-status-format &lt;span class=&#34;s1&#34;&gt;&#39; #I #[fg=white]#W #[fg=yellow]#F &#39;&lt;/span&gt;
